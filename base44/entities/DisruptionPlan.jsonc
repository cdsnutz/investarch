{
  "name": "DisruptionPlan",
  "type": "object",
  "properties": {
    "seed_id": {
      "type": "string"
    },
    "target_competitor": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "churn_analysis": {
      "type": "string"
    },
    "customer_complaints": {
      "type": "string"
    },
    "technical_debt": {
      "type": "string"
    },
    "kill_feature": {
      "type": "string"
    },
    "kill_feature_spec": {
      "type": "string"
    },
    "obsolescence_path": {
      "type": "string"
    },
    "generated_date": {
      "type": "string"
    }
  },
  "required": [
    "seed_id",
    "target_competitor",
    "kill_feature"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}