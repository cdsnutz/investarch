{
  "name": "ExecutionOrder",
  "type": "object",
  "properties": {
    "order_date": {
      "type": "string"
    },
    "build": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seed_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "protect": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seed_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "filing_type": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "liquidate": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seed_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "leverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "total_portfolio_value": {
      "type": "number"
    }
  },
  "required": [
    "order_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}