{
  "name": "GrowthKit",
  "type": "object",
  "properties": {
    "seed_id": {
      "type": "string"
    },
    "ad_copy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          },
          "copy": {
            "type": "string"
          }
        }
      }
    },
    "seo_title": {
      "type": "string"
    },
    "seo_meta": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outreach": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "post": {
            "type": "string"
          }
        }
      }
    },
    "traffic_forecast": {
      "type": "number"
    },
    "compliance_note": {
      "type": "string"
    },
    "generated_date": {
      "type": "string"
    }
  },
  "required": [
    "seed_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}