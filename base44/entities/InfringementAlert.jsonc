{
  "name": "InfringementAlert",
  "type": "object",
  "properties": {
    "seed_id": {
      "type": "string"
    },
    "suspected_infringer": {
      "type": "string"
    },
    "evidence_note": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "cease_desist_text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "letter_drafted",
        "resolved"
      ],
      "default": "letter_drafted"
    },
    "detected_date": {
      "type": "string"
    }
  },
  "required": [
    "seed_id",
    "suspected_infringer"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}