{
  "name": "IpProspectus",
  "type": "object",
  "properties": {
    "seed_id": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "prospectus": {
      "type": "string"
    },
    "offer_type": {
      "type": "string",
      "enum": [
        "licensing",
        "acquisition"
      ]
    },
    "offer_terms": {
      "type": "string"
    }
  },
  "required": [
    "seed_id",
    "prospectus"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}