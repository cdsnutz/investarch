{
  "name": "IpSeed",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "gap": {
      "type": "string"
    },
    "pain_signal": {
      "type": "string"
    },
    "source_channel": {
      "type": "string"
    },
    "solution": {
      "type": "string"
    },
    "asymmetric_score": {
      "type": "number"
    },
    "mini_plan": {
      "type": "string"
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "tech_stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "db_schema": {
          "type": "string"
        },
        "core_logic": {
          "type": "string"
        }
      }
    },
    "strategy": {
      "type": "string",
      "enum": [
        "hold",
        "flip",
        "build"
      ],
      "default": "hold"
    },
    "strategy_note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "seed",
        "built"
      ],
      "default": "seed"
    },
    "repo_name": {
      "type": "string"
    },
    "ecosystem_interlocks": {
      "type": "string"
    },
    "onboarding_guide": {
      "type": "string"
    },
    "yield_date": {
      "type": "string"
    },
    "source_seed_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_seed_titles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mix_thesis": {
      "type": "string"
    },
    "mix_score": {
      "type": "number"
    },
    "funding_playbook": {
      "type": "string"
    },
    "acquisition_playbook": {
      "type": "string"
    },
    "marketing_plan": {
      "type": "string"
    },
    "research_brief": {
      "type": "string"
    },
    "buyer_leads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "why_fit": {
            "type": "string"
          },
          "contact_role": {
            "type": "string"
          },
          "approach": {
            "type": "string"
          },
          "evidence_to_lead_with": {
            "type": "string"
          }
        }
      }
    },
    "hardening_report": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "conditional",
            "blocked"
          ]
        },
        "score": {
          "type": "number"
        },
        "summary": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        },
        "pods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pod": {
                "type": "string"
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fixes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "title",
    "gap",
    "solution",
    "yield_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}