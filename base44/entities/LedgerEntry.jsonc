{
  "name": "LedgerEntry",
  "type": "object",
  "properties": {
    "entry_type": {
      "type": "string",
      "enum": [
        "revenue",
        "reinvestment",
        "acquisition",
        "legal",
        "ops"
      ],
      "default": "revenue"
    },
    "amount": {
      "type": "number"
    },
    "asset_title": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "entry_date": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ],
      "default": "manual"
    }
  },
  "required": [
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}