{
  "name": "MarketSeed",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "vector": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "signal_score": {
      "type": "number"
    },
    "thesis": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Captured",
        "Dismissed"
      ],
      "default": "New"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}