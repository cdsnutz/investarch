{
  "name": "RegulatoryLever",
  "type": "object",
  "properties": {
    "jurisdiction": {
      "type": "string"
    },
    "framework": {
      "type": "string"
    },
    "lever_name": {
      "type": "string"
    },
    "positioning_rationale": {
      "type": "string"
    },
    "compliance_path": {
      "type": "string"
    },
    "moat_strength": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "identified",
        "analyzed",
        "positioned"
      ],
      "default": "identified"
    },
    "analyzed_date": {
      "type": "string"
    }
  },
  "required": [
    "lever_name",
    "jurisdiction"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}