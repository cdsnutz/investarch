{
  "name": "ReinvestmentDecision",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "scale",
        "patent",
        "acquire",
        "hold"
      ],
      "default": "hold"
    },
    "target_title": {
      "type": "string"
    },
    "allocation": {
      "type": "number"
    },
    "rationale": {
      "type": "string"
    },
    "decision_date": {
      "type": "string"
    }
  },
  "required": [
    "decision",
    "rationale"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}