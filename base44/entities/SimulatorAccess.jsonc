{
  "name": "SimulatorAccess",
  "type": "object",
  "properties": {
    "plan": {
      "type": "string",
      "default": "simulator_pro"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "canceled"
      ],
      "default": "active"
    },
    "billing_interval": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "default": "monthly"
    },
    "started_date": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "started_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}