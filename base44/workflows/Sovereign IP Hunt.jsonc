{
  "name": "Sovereign IP Hunt",
  "description": "Daily sovereign cycle V7: Metamorphosis learns, the hunt yields 20 IP-seeds, War-Room maps disruptions, Ghost Validation tests demand, Treasury prices the portfolio, Deployment and Traffic kits are cut, the Synergy loop cross-pollinates, the Governance Nexus scans for infringement, the Neural-CFO allocates capital, and the Execution Order is issued",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sovereign_ip_hunt",
      "version": "3.0",
      "namespace": "base44"
    },
    "do": [
      {
        "learn": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runMetamorphosis",
            "args": {}
          },
          "then": "run_hunt",
          "x-base44": {
            "title": "Metamorphosis",
            "description": "Extract learned heuristics"
          }
        }
      },
      {
        "run_hunt": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runIpHunt",
            "args": {}
          },
          "then": "assign_strategy",
          "x-base44": {
            "title": "Run the hunt",
            "description": "Signal Miner + Synthesizer"
          }
        }
      },
      {
        "assign_strategy": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ipWealthStrategy",
            "args": {}
          },
          "then": "war_room",
          "x-base44": {
            "title": "Assign wealth strategy",
            "description": "Hold / Flip / Build verdicts"
          }
        }
      },
      {
        "war_room": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runWarRoom",
            "args": {}
          },
          "then": "ghost_validate",
          "x-base44": {
            "title": "War-Room",
            "description": "Disruption blueprints"
          }
        }
      },
      {
        "ghost_validate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runGhostValidation",
            "args": {}
          },
          "then": "price_portfolio",
          "x-base44": {
            "title": "Ghost Validation",
            "description": "Amplifier demand reads"
          }
        }
      },
      {
        "price_portfolio": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runTreasury",
            "args": {}
          },
          "then": "deploy_kit",
          "x-base44": {
            "title": "Treasury",
            "description": "Price the portfolio"
          }
        }
      },
      {
        "deploy_kit": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runDeploymentKit",
            "args": {}
          },
          "then": "traffic_siphon",
          "x-base44": {
            "title": "Deployment Pod",
            "description": "Zero-touch deploy kits"
          }
        }
      },
      {
        "traffic_siphon": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runTrafficSiphon",
            "args": {}
          },
          "then": "synergy_sync",
          "x-base44": {
            "title": "Traffic-Siphon",
            "description": "Distribution kits"
          }
        }
      },
      {
        "synergy_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runSynergySync",
            "args": {}
          },
          "then": "governance_scan",
          "x-base44": {
            "title": "Synergy-Core",
            "description": "Cross-pollination upsells"
          }
        }
      },
      {
        "governance_scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runGovernanceScan",
            "args": {}
          },
          "then": "neural_cfo",
          "x-base44": {
            "title": "Governance Nexus",
            "description": "Infringement scan + C&D drafts"
          }
        }
      },
      {
        "neural_cfo": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runNeuralCFO",
            "args": {}
          },
          "then": "issue_order",
          "x-base44": {
            "title": "Neural-CFO",
            "description": "Capital allocation"
          }
        }
      },
      {
        "issue_order": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runExecutionOrder",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Execution Order",
            "description": "Build / Protect / Liquidate / Leverage"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}