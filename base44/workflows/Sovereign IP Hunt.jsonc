{
  "name": "Sovereign IP Hunt",
  "description": "Daily InvestArch IP cycle: the hunt yields 20 IP-seeds, strategy verdicts are assigned, War-Room maps disruptions, Ghost Validation tests demand, Treasury prices the portfolio, deployment kits are cut, the IP-protection watchdog scans for infringement, the capital allocator rebalances, and the execution order is issued",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sovereign_ip_hunt",
      "version": "4.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_hunt": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runIpHunt",
            "args": {}
          },
          "then": "assign_strategy",
          "x-base44": {
            "title": "Run the hunt",
            "description": "Signal Miner + Synthesizer"
          }
        }
      },
      {
        "assign_strategy": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ipWealthStrategy",
            "args": {}
          },
          "then": "war_room",
          "x-base44": {
            "title": "Assign wealth strategy",
            "description": "Hold / Flip / Build verdicts"
          }
        }
      },
      {
        "war_room": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runWarRoom",
            "args": {}
          },
          "then": "ghost_validate",
          "x-base44": {
            "title": "War-Room",
            "description": "Disruption blueprints"
          }
        }
      },
      {
        "ghost_validate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runGhostValidation",
            "args": {}
          },
          "then": "price_portfolio",
          "x-base44": {
            "title": "Ghost Validation",
            "description": "Demand reads before a cent is spent"
          }
        }
      },
      {
        "price_portfolio": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runTreasury",
            "args": {}
          },
          "then": "deploy_kit",
          "x-base44": {
            "title": "Treasury",
            "description": "Price the portfolio"
          }
        }
      },
      {
        "deploy_kit": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runDeploymentKit",
            "args": {}
          },
          "then": "governance_scan",
          "x-base44": {
            "title": "Deployment engine",
            "description": "Zero-touch deploy kits"
          }
        }
      },
      {
        "governance_scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runGovernanceScan",
            "args": {}
          },
          "then": "neural_cfo",
          "x-base44": {
            "title": "IP-protection watchdog",
            "description": "Infringement scan + C&D drafts"
          }
        }
      },
      {
        "neural_cfo": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runNeuralCFO",
            "args": {}
          },
          "then": "issue_order",
          "x-base44": {
            "title": "Capital allocator",
            "description": "Reinvestment decisions"
          }
        }
      },
      {
        "issue_order": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runExecutionOrder",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Execution Order",
            "description": "Build / Protect / Liquidate / Leverage"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}